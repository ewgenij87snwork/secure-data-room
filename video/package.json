    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.508",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.508"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.2"
  }
}
