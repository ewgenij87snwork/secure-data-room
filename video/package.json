{
  "name": "secure-data-room-video",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SdrHero out/secure-data-room-remotion.mp4 --codec=h264 --crf=18",
