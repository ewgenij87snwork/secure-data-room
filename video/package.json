{
  "name": "secure-data-room-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SdrHero out/secure-data-room-demo-master.mp4 --codec=h264 --crf=14",
    "render:gif": "remotion render src/index.ts SdrHero out/secure-data-room-demo.gif --codec=gif --every-nth-frame=3",
    "test:workflow": "node --experimental-strip-types --test tests/storyboard.test.ts scripts/video-workflow.test.ts",
    "still": "node --experimental-strip-types scripts/video-workflow.ts still",
    "draft:scene": "node --experimental-strip-types scripts/video-workflow.ts draft:scene",
    "review": "node --experimental-strip-types scripts/video-workflow.ts review",
    "deliver": "node --experimental-strip-types scripts/video-workflow.ts deliver",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.508",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.508"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.2"
  }
}
