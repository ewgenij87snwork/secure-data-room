{
  "name": "secure-data-room",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, reviewer-ready virtual Data Room MVP.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "workspace:prepare": "pnpm --filter @data-room/contracts build && pnpm prisma:generate",
    "dev": "pnpm workspace:prepare && pnpm --parallel --filter @data-room/api --filter @data-room/web dev",
    "build": "pnpm workspace:prepare && pnpm build:workspaces",
    "build:workspaces": "pnpm --filter @data-room/api build && pnpm --filter @data-room/web build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm workspace:prepare && pnpm typecheck:workspaces",
    "typecheck:workspaces": "pnpm typecheck:tools && pnpm --filter @data-room/contracts typecheck && pnpm --filter @data-room/api typecheck && pnpm --filter @data-room/web typecheck",
    "typecheck:tools": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:run",
    "test:run": "pnpm workspace:prepare && pnpm test:scripts && pnpm test:run:workspaces",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:run:workspaces": "pnpm --filter @data-room/contracts test:run && pnpm --filter @data-room/api test:run && pnpm --filter @data-room/web test:run",
    "contracts:check": "pnpm --filter @data-room/contracts build && pnpm --filter @data-room/contracts test:run && pnpm --filter @data-room/contracts typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "architecture:check": "node scripts/check-architecture.mjs",
    "placeholders:check": "node scripts/check-placeholders.mjs",
    "requirements:check": "node scripts/check-requirements.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "generated:check": "node scripts/check-generated-artifacts.mjs",
    "progress": "node scripts/progress-report.mjs",
    "verify": "pnpm workspace:prepare && pnpm architecture:check && pnpm requirements:check && pnpm placeholders:check && pnpm lint && pnpm format:check && pnpm typecheck:workspaces && pnpm test:scripts && pnpm test:run:workspaces && pnpm build:workspaces && pnpm generated:check && pnpm security:scan && git diff --check",
    "worktrees:create": "bash scripts/create-worktrees.sh",
    "ops:status": "tsx scripts/runtime-control.ts status",
    "ops:review-mode": "tsx scripts/runtime-control.ts review",
    "ops:lockdown": "tsx scripts/runtime-control.ts lockdown",
    "ops:maintenance:on": "tsx scripts/runtime-control.ts maintenance-on",
    "ops:maintenance:off": "tsx scripts/runtime-control.ts maintenance-off",
    "worktrees:capabilities": "bash scripts/create-capabilities-worktree.sh",
    "git:check": "git diff --check && test -z \"$(git status --porcelain --untracked-files=no)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.62.1",
    "@prisma/adapter-pg": "7.9.1",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prisma": "7.9.1",
    "tsx": "^4.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
