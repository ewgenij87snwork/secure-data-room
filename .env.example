# Shared identity/deployment metadata
APP_VERSION=local
GIT_COMMIT_SHA=local

# API runtime
PORT=3000
WEB_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=replace-locally
STORAGE_BUCKET=data-room-pdfs

# Browser-safe variables only. API base URL must end in /v1/.
VITE_API_BASE_URL=http://localhost:3000/v1/
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-locally
VITE_BUILD_SHA=local

# Local/release operations only. Never add these to browser env or commit their values.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=local
SUPABASE_ACCESS_TOKEN=replace-locally
